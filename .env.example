# Токен Notion-інтеграції (notion.so/my-integrations), підключеної до сторінки D.YOUTH WORSHIP
NOTION_TOKEN=
# Токен Telegram-бота від @BotFather. Потрібен лише для перевірки підпису користувача
BOT_TOKEN=
# chat_id адмінів через кому: можуть редагувати сет-лист будь-якого служіння
ADMIN_CHAT_IDS=244629540
# Посилання на застосунок (t.me/ВАШ_БОТ/ім'я). Якщо задано, повідомлення зі сет-листом отримує кнопку «Відкрити»
MINIAPP_LINK=
# Лише для локальної перевірки без Telegram. На проді НЕ задавати
DEV_CHAT_ID=
# Секрет вебхука бота (довільний довгий рядок) — той самий передається в setWebhook як secret_token
BOT_WEBHOOK_SECRET=
# Секрет для Vercel Cron (довільний довгий рядок). Vercel надсилає його як Authorization: Bearer ...
CRON_SECRET=
